# ==============================================================================
# ByteCraft Backend Environment Variables Example
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=5000
CLIENT_URL=http://bytecraft-dev.vercel.app
MONGODB_URI=mongodb://127.0.0.1:27017/bytecraft
JWT_SECRET=replace_this_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=lax
TRUST_PROXY=false

# Owner Account (Used exclusively by seed:owner script)
OWNER_NAME=ByteCraft Owner
OWNER_EMAIL=owner@bytecraft.dev
OWNER_PASSWORD=change_me

# Cloudinary Assets Storage (Phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail / SMTP Notifications (Phase 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
OWNER_NOTIFY_EMAIL=

# Paymob Payment Gateway (Phase 5)
PAYMOB_MODE=sandbox        # sandbox | live
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_FAWRY_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# GitHub Automation (Phase 4)
AUTO_GITHUB_INVITE=false
GITHUB_TOKEN=
