# ==============================================================================
# ByteCraft Backend Environment Variables Example
# ==============================================================================

# Server Environment & Network
NODE_ENV=development                                # development | production | test
PORT=5000

# Client Origins for CORS (supports single origin or comma-separated list of origins)
# Example: http://localhost:5173 or https://bytecraft.dev,http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bytecraft?retryWrites=true&w=majority

# Owner Session & JWT Security
JWT_SECRET=replace_this_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=lax                                 # lax | none | strict (if 'none', Secure is automatically enforced)

# Reverse Proxy Trust Configuration
# Number of reverse proxy hops to trust (default 1).
# Production topology: Browser -> Frontend Vercel (hop 1) -> Backend Vercel (hop 2) -> set to 2.
TRUST_PROXY=1

# Serverless Cron Job Secret (Required in production, min 16 characters)
# Sent in header: Authorization: Bearer <CRON_SECRET> for GET /api/cron/expire-orders
CRON_SECRET=replace_with_a_secure_cron_secret_at_least_16_chars

# Owner Account Seed Credentials (Used exclusively by "npm run seed:owner")
OWNER_NAME=ByteCraft Owner
OWNER_EMAIL=owner@bytecraft.dev
OWNER_PASSWORD=change_me

# Cloudinary Assets Storage (Image & Proof uploads)
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# Mail / SMTP Notifications (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change_me
MAIL_FROM="ByteCraft Studio <noreply@bytecraft.dev>"
OWNER_NOTIFY_EMAIL=owner@bytecraft.dev

# Paymob Payment Gateway (Accept API)
PAYMOB_MODE=sandbox                                 # sandbox | live
PAYMOB_API_KEY=change_me
PAYMOB_HMAC_SECRET=change_me
PAYMOB_CARD_INTEGRATION_ID=change_me
PAYMOB_FAWRY_INTEGRATION_ID=change_me
PAYMOB_IFRAME_ID=change_me

# Automated GitHub Repository Invitations
AUTO_GITHUB_INVITE=false
GITHUB_TOKEN=ghp_change_me
