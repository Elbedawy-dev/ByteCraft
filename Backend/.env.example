NODE_ENV=development
PORT=5000
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus?appName=Nexus

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_secret
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=lax
TRUST_PROXY=1

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace_with_64_char_random_hex_secret

OWNER_NAME=Admin Name
OWNER_EMAIL=admin@yourdomain.com
OWNER_PASSWORD=replace_with_strong_password_min_8_chars

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="Nexus <noreply@yourdomain.com>"

# Optional override for owner notifications (defaults to OWNER_EMAIL)
# OWNER_NOTIFY_EMAIL=

# Optional: Paymob Accept Gateway (completely optional — vodafone_cash and instapay work standalone without it).
# All-or-nothing rule: if any of PAYMOB_API_KEY, PAYMOB_HMAC_SECRET, PAYMOB_CARD_INTEGRATION_ID,
# or PAYMOB_IFRAME_ID is set (non-empty, not containing "placeholder"), all four must be set.
# Add PAYMOB_FAWRY_INTEGRATION_ID as well to enable Fawry; otherwise leave all PAYMOB_* unset/commented.
# PAYMOB_MODE=sandbox
# PAYMOB_API_KEY=
# PAYMOB_HMAC_SECRET=
# PAYMOB_CARD_INTEGRATION_ID=
# PAYMOB_FAWRY_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=

AUTO_GITHUB_INVITE=false
GITHUB_TOKEN=
