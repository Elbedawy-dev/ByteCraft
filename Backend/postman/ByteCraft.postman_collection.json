	"item": [
		{
			"name": "Platform Meta & Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Liveness check. Returns status, uptime, timestamp, and database connection state."
					}
				},
				{
					"name": "Get Platform Meta",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/meta",
							"host": ["{{baseUrl}}"],
							"path": ["meta"]
						},
						"description": "Public platform metadata: siteName, guaranteeDays, contact, active categories, and sanitized paymentMethods (enabled flags & bilingual instructions only; no walletNumber/ipa/accountName)."
					}
				}
			]
		},
		{
			"name": "Owner Auth",
			"item": [
				{
					"name": "Owner Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"owner@bytecraft.dev\",\n  \"password\": \"OwnerSecretPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/owner/login",
							"host": ["{{baseUrl}}"],
							"path": ["owner", "login"]
						},
						"description": "Logs in the owner and sets an httpOnly cookie (bc_owner). Rate limited to 5 failed attempts / 15 min / IP."
					}
				},
				{
					"name": "Get Current Owner (Me)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/owner/me",
							"host": ["{{baseUrl}}"],
							"path": ["owner", "me"]
						},
						"description": "Returns current logged-in owner profile."
					}
				},
				{
					"name": "Change Password",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"currentPassword\": \"OwnerSecretPassword123!\",\n  \"newPassword\": \"NewSuperSecretPassword2026!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/owner/password",
							"host": ["{{baseUrl}}"],
							"path": ["owner", "password"]
						},
						"description": "Changes the owner password. Requires currentPassword and newPassword (min 8 chars)."
					}
				},
				{
					"name": "Owner Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/owner/logout",
							"host": ["{{baseUrl}}"],
							"path": ["owner", "logout"]
						},
						"description": "Clears the bc_owner session cookie."
					}
				}
			]
		},
