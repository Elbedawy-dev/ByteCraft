								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"slug\": \"lms-pro-platform\",\n  \"title\": {\n    \"ar\": \"منصة تعليمية احترافية\",\n    \"en\": \"LMS Pro Platform\"\n  },\n  \"tagline\": {\n    \"ar\": \"نظام متكامل لإدارة الدورات والطلاب\",\n    \"en\": \"Complete MERN LMS for academies\"\n  },\n  \"description\": {\n    \"ar\": \"منصة تعليمية جاهزة بالكامل مبنية بـ MERN Stack مع بوابات دفع ولوحة تحكم شاملة.\",\n    \"en\": \"Turnkey MERN learning management system with payment gateways and analytics dashboard.\"\n  },\n  \"category\": \"{{categoryId}}\",\n  \"techStack\": [\"React\", \"Node.js\", \"Express\", \"MongoDB\", \"TailwindCSS\"],\n  \"features\": [\n    { \"ar\": \"بث فيديو محمي\", \"en\": \"Protected video streaming\" },\n    { \"ar\": \"بوابات دفع مصرية\", \"en\": \"Egyptian payment gateways\" }\n  ],\n  \"thumbnail\": {\n    \"url\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\",\n    \"publicId\": \"bytecraft/projects/sample\"\n  },\n  \"gallery\": [\n    {\n      \"url\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\",\n      \"publicId\": \"bytecraft/projects/sample-1\"\n    }\n  ],\n  \"preview\": {\n    \"url\": \"https://demo.bytecraft.dev/lms-pro\",\n    \"mode\": \"iframe\",\n    \"demoNote\": {\n      \"ar\": \"استخدم الحساب التجريبي للدخول\",\n      \"en\": \"Use demo credentials to explore\"\n    },\n    \"demoCredentials\": {\n      \"label\": \"Teacher Demo\",\n      \"email\": \"demo@lms.dev\",\n      \"password\": \"DemoUser123!\"\n    }\n  },\n  \"packages\": [\n    {\n      \"key\": \"standard\",\n      \"name\": { \"ar\": \"ترخيص فردي\", \"en\": \"Standard License\" },\n      \"price\": 780000,\n      \"compareAtPrice\": 950000,\n      \"features\": [\n        { \"ar\": \"كود المصدر كاملاً\", \"en\": \"Full source code\" },\n        { \"ar\": \"دعم فني 30 يوم\", \"en\": \"30 days support\" }\n      ],\n      \"licenseType\": \"single\",\n      \"supportDays\": 30,\n      \"isPopular\": true,\n      \"isActive\": true\n    }\n  ],\n  \"privateRepo\": {\n    \"provider\": \"github\",\n    \"owner\": \"ByteCraftDev\",\n    \"name\": \"lms-pro-private\",\n    \"url\": \"https://github.com/ByteCraftDev/lms-pro-private\"\n  },\n  \"status\": \"published\",\n  \"isFeatured\": true,\n  \"sortOrder\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/owner/projects",
							"host": ["{{baseUrl}}"],
							"path": ["owner", "projects"]
						},
						"description": "Creates a new project. All prices are integers in piasters (780000 = 7,800 EGP). Published projects must have at least one active package."
					}
				},
