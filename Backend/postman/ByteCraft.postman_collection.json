								{ "key": "status", "value": "", "description": "draft | published | archived" },
								{ "key": "category", "value": "", "description": "Category ObjectId or key" },
								{ "key": "search", "value": "" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10", "description": "1..50" }
