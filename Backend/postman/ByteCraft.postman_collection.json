		{
			"name": "Projects",
			"item": [
				{
					"name": "Public List Projects",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects?category=&tech=&featured=&search=&minPrice=&maxPrice=&sort=newest&page=1&limit=12",
							"host": ["{{baseUrl}}"],
							"path": ["projects"],
							"query": [
								{ "key": "category", "value": "", "description": "Category key slug" },
								{ "key": "tech", "value": "", "description": "Comma-separated tech stack items (e.g. React,Node.js)" },
								{ "key": "featured", "value": "", "description": "true | false" },
								{ "key": "search", "value": "" },
								{ "key": "minPrice", "value": "", "description": "Integer piasters" },
								{ "key": "maxPrice", "value": "", "description": "Integer piasters" },
								{ "key": "sort", "value": "newest", "description": "newest | popular | price_asc | price_desc" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "12", "description": "1..50" }
							]
						},
						"description": "Lists published projects with computed startingPrice (cheapest active package, piasters) and reviewsSummary ({ average, count } of published reviews). Active packages only; privateRepo is never exposed; consistent `id`."
					}
				},
				{
					"name": "Public Project Detail",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects/{{projectSlug}}",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{projectSlug}}"]
						},
						"description": "Gets single published project details including preview object, active packages only, computed startingPrice, and reviewsSummary ({ average, count }). Increments stats.views for non-owner visitors. privateRepo is hidden."
					}
				},
				{
					"name": "Track Preview View",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects/{{projectSlug}}/preview-view",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{projectSlug}}", "preview-view"]
						},
						"description": "Increments stats.previewViews counter. Rate limited (60 / 15 min / IP)."
					}
				},
				{
					"name": "Public Project Reviews",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects/{{projectSlug}}/reviews?page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{projectSlug}}", "reviews"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10", "description": "1..50" }
							]
						},
						"description": "Public published reviews for a project. Customer names are masked (e.g. Ahmed M.); orderNumber/email/phone/token are never returned."
					}
				},
