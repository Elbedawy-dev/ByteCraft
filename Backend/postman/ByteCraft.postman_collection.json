			"name": "Platform Meta & Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Liveness check. Returns status OK and timestamp."
					}
				},
				{
					"name": "Get Platform Meta",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/meta",
							"host": ["{{baseUrl}}"],
							"path": ["meta"]
						},
						"description": "Public platform metadata for the frontend: active categories, enabled payment methods (safe flags only, no wallet numbers/IPA), guarantee days, and public contact info."
