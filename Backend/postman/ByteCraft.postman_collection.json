						"body": {
							"mode": "raw",
							"raw": "{\n  \"siteName\": \"ByteCraft\",\n  \"guaranteeDays\": 30,\n  \"contact\": {\n    \"email\": \"contact@bytecraft.dev\",\n    \"phone\": \"+201012345678\",\n    \"whatsapp\": \"+201012345678\",\n    \"location\": {\n      \"ar\": \"القاهرة، مصر\",\n      \"en\": \"Cairo, Egypt\"\n    },\n    \"socials\": {\n      \"github\": \"https://github.com/ByteCraft\",\n      \"linkedin\": \"https://linkedin.com/company/bytecraft\",\n      \"twitter\": \"\",\n      \"facebook\": \"\"\n    }\n  },\n  \"paymentMethods\": {\n    \"vodafone_cash\": {\n      \"enabled\": true,\n      \"walletNumber\": \"01012345678\",\n      \"accountName\": \"ByteCraft Studio\",\n      \"instructions\": {\n        \"ar\": \"حول المبلغ المطلوب عبر فودافون كاش ثم ارفع إيصال التحويل.\",\n        \"en\": \"Transfer the required amount via Vodafone Cash and upload the payment proof.\"\n      }\n    },\n    \"instapay\": {\n      \"enabled\": true,\n      \"ipa\": \"bytecraft@instapay\",\n      \"accountName\": \"ByteCraft Studio\",\n      \"instructions\": {\n        \"ar\": \"حول المبلغ المطلوب عبر انستاباي ثم ارفع إيصال التحويل.\",\n        \"en\": \"Transfer the required amount via InstaPay and upload the payment proof.\"\n      }\n    },\n    \"card\": {\n      \"enabled\": true\n    },\n    \"fawry\": {\n      \"enabled\": true\n    }\n  }\n}"
