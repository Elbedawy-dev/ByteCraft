		{
			"name": "Owner Auth",
			"item": [
				{
					"name": "Owner Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"owner@bytecraft.dev\",\n  \"password\": \"OwnerSecretPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/owner/login",
							"host": ["{{baseUrl}}"],
							"path": ["owner", "login"]
						},
						"description": "Logs in the owner and sets an httpOnly cookie (bc_owner). Rate limited to 5 attempts / 15 min / IP."
