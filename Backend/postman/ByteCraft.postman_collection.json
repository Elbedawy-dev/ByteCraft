						"url": {
							"raw": "{{baseUrl}}/owner/password",
							"host": ["{{baseUrl}}"],
							"path": ["owner", "password"]
						},
						"description": "Changes the owner password. Requires providing the current password."
					}
				},
				{
					"name": "Owner Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/owner/logout",
							"host": ["{{baseUrl}}"],
							"path": ["owner", "logout"]
