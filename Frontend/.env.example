# Production API origin (no trailing slash, e.g. https://api.bytecraft.dev)
# Leave empty in local dev so Vite proxies /api and /uploads automatically.
VITE_API_URL=

# Local dev Vite proxy target (default: http://localhost:5000)
# Use http://localhost:5001 when running Backend in test mode (npm run dev:test).
VITE_DEV_API_TARGET=http://localhost:5000
